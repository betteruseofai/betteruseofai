{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "data/**",
        "schema/**",
        "scripts/**",
        "*.css",
        "*.json",
        "tsconfig.json",
        "content/**",
        "public/**",
        "astro.config.mjs",
        "pages/**"
      ],
      "outputs": [
        "dist/**",
        "fonts/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "src/**",
        "test/**",
        "data/**",
        "schema/**",
        "scripts/**",
        "../../fixtures/**"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "copy": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    }
  }
}
