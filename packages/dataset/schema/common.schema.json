{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betteruseofai.org/schema/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "range": {
      "title": "Range",
      "description": "Every number in this dataset is a range. The build script checks low <= central <= high.",
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "central", "high"],
      "properties": {
        "low": { "type": "number" },
        "central": { "type": "number" },
        "high": { "type": "number" }
      }
    },
    "nonNegativeRange": {
      "allOf": [{ "$ref": "#/$defs/range" }],
      "type": "object",
      "properties": {
        "low": { "type": "number", "minimum": 0 },
        "central": { "type": "number", "minimum": 0 },
        "high": { "type": "number", "minimum": 0 }
      }
    },
    "source": {
      "title": "Source",
      "description": "Where a number came from. A row without one is rejected.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "publisher", "date", "retrieved"],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "url": { "type": "string", "format": "uri" },
        "publisher": { "type": "string", "minLength": 2 },
        "date": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" },
        "retrieved": { "type": "string", "format": "date" },
        "doi": { "type": "string" },
        "licence": { "type": "string" }
      }
    },
    "provenance": {
      "title": "Provenance",
      "description": "How the value in this row reached the repository, so re-check debt is machine readable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "recorded"],
      "properties": {
        "method": {
          "enum": ["source-appendix", "recalled-pending-refetch", "fetched"],
          "description": "source-appendix: transcribed from the researched appendix in PLAN.md. recalled-pending-refetch: written from memory of the published dataset and not yet checked against the file. fetched: read from the source during this change."
        },
        "recorded": { "type": "string", "format": "date" },
        "note": { "type": "string" }
      }
    },
    "isoDate": { "type": "string", "format": "date" }
  }
}
