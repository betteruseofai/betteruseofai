{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betteruseofai.org/schema/regions.schema.json",
  "title": "Regions",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaultRegion", "regions"],
  "properties": {
    "version": { "type": "string" },
    "notes": { "type": "string" },
    "defaultRegion": { "type": "string" },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/region" }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "kind",
        "gridGco2PerKwh",
        "waterOffsiteLPerKwh",
        "year",
        "source",
        "provenance"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,}(-[A-Z0-9]+)*$",
          "description": "ISO 3166-1 alpha-2, an eGRID subregion, WORLD, or a provider fleet code."
        },
        "name": { "type": "string", "minLength": 2 },
        "kind": { "enum": ["world", "country", "subregion", "provider-fleet"] },
        "continent": {
          "enum": ["Africa", "Asia", "Europe", "North America", "Oceania", "South America", "Global"]
        },
        "gridGco2PerKwh": {
          "$ref": "common.schema.json#/$defs/nonNegativeRange",
          "description": "Location-based grid intensity. This is the default basis for carbon."
        },
        "waterOffsiteLPerKwh": {
          "$ref": "common.schema.json#/$defs/nonNegativeRange",
          "description": "Water consumed generating the electricity, separate from on-site cooling."
        },
        "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
        "source": { "$ref": "common.schema.json#/$defs/source" },
        "waterSource": { "$ref": "common.schema.json#/$defs/source" },
        "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
        "notes": { "type": "string" }
      }
    }
  }
}
