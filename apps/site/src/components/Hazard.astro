---
/**
 * The caveat block. One per page, which the copy lint enforces: a page with
 * four warnings on it has taught the reader to skip warnings.
 */
interface Props {
  label?: string;
}
const { label = 'Read this before quoting the number' } = Astro.props;
---

<div class="buoa-hazard measure">
  <span class="buoa-hazard__label">{label}</span>
  <slot />
</div>
