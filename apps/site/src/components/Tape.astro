---
interface Props {
  text?: string;
  times?: number;
}
const { text = 'Estimate · not a measurement', times = 6 } = Astro.props;
const run = Array.from({ length: times }, () => text).join(' · ');
---

<div class="buai-tape" aria-hidden="true">{run}</div>
<span class="buai-visually-hidden">{text}</span>
