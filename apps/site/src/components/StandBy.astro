---
interface Props {
  code: string;
  heading: string;
  /** The design sheet shows this inside a page that already has an h1. */
  level?: 1 | 2;
}
const { code, heading, level = 1 } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2';
---

<div class="buoa-standby">
  <span class="buoa-standby__code">{code}</span>
  <Heading>{heading}</Heading>
  <slot />
</div>
