---
/**
 * The top navigation. Five links and two toggles, on one rule.
 *
 * No dropdowns and no burger. At 390 px the links wrap onto a second row,
 * which is fine, and is why the brand sits on its own line there.
 */
import ThemeToggle from './ThemeToggle.astro';
import StillToggle from './StillToggle.astro';
import markSvg from '../../../../packages/tokens/logo/svg/b-die.svg?raw';

// The mark, inlined at build time so it inherits the brand's ink and needs no
// request of its own. Stripped of its label; the words beside it are the label.
const mark = markSvg
  .replace(/ role="img" aria-label="[^"]*"/, ' aria-hidden="true" class="buai-nav__mark"')
  .replace(/ width="16" height="16"/, '');

interface Props {
  here?: string;
}

const { here } = Astro.props;

const links = [
  { href: '/methodology', label: 'Method' },
  { href: '/calculator', label: 'Calculator' },
  { href: '/install', label: 'Install' },
  { href: '/blog', label: 'Writing' },
  { href: '/about', label: 'About' },
];
---

<nav class="buai-nav" aria-label="Main">
  <a class="buai-nav__brand" href="/"><Fragment set:html={mark} />Better Use of AI</a>
  {
    links.map((link) => (
      <a href={link.href} aria-current={here === link.href ? 'page' : undefined}>
        {link.label}
      </a>
    ))
  }
  <StillToggle />
  <ThemeToggle />
</nav>
