---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { postIsVisible, type Status } from '../../../lib/status';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) =>
    postIsVisible(post.data.status as Status),
  );
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)), tag },
  }));
}

const { posts, tag } = Astro.props;
---

<Base title={`Writing tagged ${tag}`} description={`Posts about ${tag}.`} status="draft" here="/blog">
  <section class="band band--first">
    <p class="note"><a href="/blog">Writing</a></p>
    <h1 class="statement" style="font-size: var(--step-4)">{tag}</h1>
  </section>

  <section class="band">
    <ul class="postlist">
      {
        posts.map((post: { id: string; data: { title: string; description: string; date: Date } }) => (
          <li>
            <a href={`/blog/${post.id}`}>
              <span class="postlist__date">{post.data.date.toISOString().slice(0, 10)}</span>
              <span class="postlist__title">{post.data.title}</span>
              <span class="postlist__desc">{post.data.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
