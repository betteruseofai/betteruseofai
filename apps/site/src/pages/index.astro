---
import Base from '../layouts/Base.astro';
import DitherField from '../components/DitherField.astro';
import Readout from '../components/Readout.astro';
import RangeBar from '../components/RangeBar.astro';
import Index from '../components/Index.astro';
import Hazard from '../components/Hazard.astro';
import Redacted from '../components/Redacted.astro';
import Tape from '../components/Tape.astro';
import Faq from '../components/Faq.astro';
import SourceChip from '../components/SourceChip.astro';
import dataset from '../lib/dataset';
import { displayNumber } from '@betteruseofai/core';
import { CHOICES, PLACES, buildTable } from '../lib/landing';

const table = buildTable();
const start = { model: 'claude-opus-5', place: 'WORLD', prompts: 20 };
const cell = table[`${start.model}|${start.place}`]!;

const perDay = (value: { low: number; central: number; high: number } | null) =>
  value
    ? { low: value.low * start.prompts, central: value.central * start.prompts, high: value.high * start.prompts }
    : null;

/*
 * Every citation on this page is read out of the dataset row it rests on,
 * rather than typed here. The first version linked the Google chip to a blog
 * root instead of the paper, and nothing could have caught that.
 */
const row = (id: string) => dataset.benchmarks.find((one) => one.id === id);
const google = row('google.gemini-apps.2025-median');
const mistral = row('mistral.large-2.lca.2025');

/*
 * The same exchange, priced four ways. The ceiling is shared so the four bars
 * can be read against each other, which is the whole point of showing them
 * together: the gap between the rows is the one thing on this page anyone can
 * act on.
 */
const proof = CHOICES.map((choice) => {
  const one = table[`${choice.id}|${start.place}`]!;
  return { choice, cell: one, row: one.rowId ? row(one.rowId) : undefined };
});
const ceiling = Math.max(...proof.map((one) => one.cell.energyWh?.high ?? 0));

const sections = 7;
---

<Base
  title="Your prompts have a water bill"
  description="Work out the energy, water and carbon behind your own use of large language models, with the uncertainty left in, on your own machine."
  status="draft"
  here="/"
  paper
>

  <section class="band band--first band--dither" data-landing data-dither-track>
    <DitherField />

    <div class="hero">
      <h1 class="statement">Your prompts have a water bill.</h1>

      <p class="dialer">
      I send about
      <input
        type="number"
        min="1"
        max="500"
        value={start.prompts}
        aria-label="Prompts a day"
        data-dial="prompts"
      />
      prompts a day to
      <select aria-label="Which model" data-dial="model">
        {
          CHOICES.map((choice) => (
            <option value={choice.id} selected={choice.id === start.model}>
              {choice.label}
            </option>
          ))
        }
      </select>
      from
      <select aria-label="Where the electricity comes from" data-dial="place">
        {
          PLACES.map((place) => (
            <option value={place.code} selected={place.code === start.place}>
              {place.label}
            </option>
          ))
        }
      </select>.
      </p>
    </div>

    <div class="cols">
      <div data-slot="energy">
        <Readout label="Energy a day" range={perDay(cell.energyWh)} unit="Wh" atLeast={cell.atLeast} />
        <RangeBar range={perDay(cell.energyWh)} />
      </div>
      <div data-slot="water">
        <Readout label="Water a day" range={perDay(cell.waterMl)} unit="mL" atLeast={cell.atLeast} />
        <RangeBar range={perDay(cell.waterMl)} />
      </div>
      <div data-slot="carbon">
        <Readout label="Carbon a day" range={perDay(cell.carbonG)} unit="g" atLeast={cell.atLeast} />
        <RangeBar range={perDay(cell.carbonG)} />
      </div>
    </div>

    <p class="note note--ink" style="margin-top: var(--space-5)" data-caveat>
      The spread is the disagreement between published measurements, not our own error bars.
    </p>
  </section>

  <Tape />

  <section class="band">
    <div class="band__head">
      <Index n={1} of={sections} />
      <h2 class="band__title">What the range is doing there</h2>
    </div>

    <div class="prose">
      <p>
        Nobody outside the labs knows what a prompt costs. Google puts a median text prompt at
        0.24 Wh and 0.26 mL of water on site<SourceChip
          n="1"
          title={google?.source.title ?? 'Measuring the environmental impact of AI inference'}
          publisher={google?.source.publisher ?? 'Google'}
          date={google?.source.date ?? '2025-08-21'}
          retrieved={google?.source.retrieved}
          url={google?.source.url}
        />. A life cycle study of Mistral Large 2 lands nearer 45 mL for one page of
        text<SourceChip
          n="2"
          title={mistral?.source.title ?? 'Our contribution to a global environmental standard for AI'}
          publisher={mistral?.source.publisher ?? 'Mistral'}
          date={mistral?.source.date ?? '2025-07-22'}
          retrieved={mistral?.source.retrieved}
          url={mistral?.source.url}
        />. Both are honest. They are counting different things across different boundaries.
      </p>
      <p>
        So we show the whole spread instead of picking a favourite, and every figure says which
        measurement it leant on. A single number here would be easier to read and would be a lie
        about how much is known.
      </p>
      <p>
        Some models think before answering and do not say how much. Where that happens the low
        bound assumes none, and the figure carries a "greater than or equal to" mark. We would
        rather say so on the page than quietly pick a middle.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="band__head">
      <Index n={2} of={sections} />
      <h2 class="band__title">What a prompt actually draws on</h2>
    </div>

    <div class="prose">
      <p>
        A prompt is a few hundred tokens leaving a box. Behind the box is a server drawing power, a
        building keeping it cool, a grid making the electricity, and a power station using water
        to make it. Further back still is the land the building stands on and the water that went
        into the chips. The diagram traces the line back. What we count, we count with a source
        beside it. What we cannot count is drawn without a number.
      </p>
    </div>

    {/*
      Decorative in the sense that the words beneath carry the meaning; the
      picture is the same three shapes the backdrop uses, held still.
    */}
    <svg class="cost" viewBox="0 0 640 260" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <!-- the prompt box, and the cursor cell -->
      <rect x="468" y="99" width="150" height="62" />
      <rect x="480" y="111" width="5" height="20" fill="currentColor" stroke="none" />
      <rect x="596" y="139" width="12" height="12" fill="currentColor" stroke="none" opacity="0.8" />

      <!-- one trace out of the box, fanning to three -->
      <path d="M468 130 H392" />
      <circle cx="392" cy="130" r="3" fill="currentColor" stroke="none" />
      <path d="M392 130 V50 H190" />
      <path d="M392 130 H190" />
      <path d="M392 130 V210 H190" />
      <circle cx="190" cy="50" r="3" fill="currentColor" stroke="none" />
      <circle cx="190" cy="130" r="3" fill="currentColor" stroke="none" />
      <circle cx="190" cy="210" r="3" fill="currentColor" stroke="none" />

      <!-- watts: a lattice, which is a rack and a grid at once -->
      <g transform="translate(130 50)">
        {[-40, -24, -8, 8, 24].map((x) =>
          [-16, 0, 16].map((y) => <rect x={x} y={y - 4} width="8" height="8" fill="currentColor" stroke="none" opacity="0.85" />),
        )}
        <path d="M-52 -26 V26 M52 -26 V26 M-52 -26 H52 M-52 26 H52" opacity="0.7" />
      </g>

      <!-- water: rings, which are a ripple and a lithography pattern at once -->
      <g transform="translate(130 130)">
        <circle r="7" />
        <circle r="16" opacity="0.85" />
        <circle r="25" opacity="0.65" />
        <circle r="34" opacity="0.45" />
      </g>

      <!-- land: strata, which are soil horizons and wafer layers at once -->
      <g transform="translate(130 210)">
        <path d="M-52 -24 H52 M-52 -8 H52 M-52 8 H52 M-52 24 H52" />
        <path d="M-24 -24 V8 M16 -8 V24 M-4 8 V24" opacity="0.7" />
      </g>
    </svg>

    <dl class="cost__legend">
      <div>
        <dt>Watts</dt>
        <dd>
          Counted. The energy the accelerator and its host drew for your tokens, plus the building
          around them, from Google's own fleet measurement<SourceChip
            n="3"
            title={google?.source.title ?? 'Measuring the environmental impact of AI inference'}
            publisher={google?.source.publisher ?? 'Google'}
            date={google?.source.date ?? '2025-08-21'}
            retrieved={google?.source.retrieved}
            url={google?.source.url}
          /> and from independent benchmarks where a provider has published nothing.
        </dd>
      </div>
      <div>
        <dt>Water</dt>
        <dd>
          Counted, twice. Water evaporated cooling the building, and water used at the power station
          that made the electricity. The second is usually the larger and depends on where you are.
          The <a href="/methodology#water">method page</a> has both factors and their sources.
        </dd>
      </div>
      <div>
        <dt>Land</dt>
        <dd>
          Not counted. Nobody has published a per-prompt figure for the ground a data centre stands
          on or the ultrapure water that went into its chips, so this stays a shape without a number
          rather than a number without a source.
        </dd>
      </div>
    </dl>
  </section>

  <section class="band">
    <div class="band__head">
      <Index n={3} of={sections} />
      <h2 class="band__title">How the figure is worked out</h2>
    </div>

    <ol class="steps">
      <li>
        <span>
          <strong>Count the tokens.</strong> Where the provider reports them we use theirs. Where it
          does not, we count with an open tokenizer and apply a measured correction, and the figure
          carries a tilde.
        </span>
      </li>
      <li>
        <span>
          <strong>Pick a published measurement.</strong> Every model points at a benchmark row with a
          source, a boundary, a method and a quality score. A model nobody has measured is scaled
          from one that has, and says so.
        </span>
      </li>
      <li>
        <span>
          <strong>Multiply, and keep the spread.</strong> Energy per token times tokens, then the grid
          where you are for carbon and the building's water use for water. Every input is a range,
          so the answer is one.
        </span>
      </li>
      <li>
        <span>
          <strong>Show the working.</strong> Each figure names its row, its flags and its source. The
          same engine runs in the extension, both command line tools and this page, from one
          dataset with one hash.
        </span>
      </li>
    </ol>
  </section>

  <section class="band">
    <div class="band__head">
      <Index n={4} of={sections} />
      <h2 class="band__title">The same question, four ways</h2>
    </div>

    <div class="prose">
      <p>
        One typical exchange, four hundred tokens in and three hundred out, on the world average
        grid. The bars share one scale, so the gap between them is real. The last row is a formula
        rather than a measurement and is likely to be low; the <a href="/methodology#local">method
        page</a> says by how much.
      </p>
    </div>

    <ul class="proof">
      {
        proof.map(({ choice, cell: one, row: source }, i) => (
          <li>
            <div class="proof__row">
              <span class="proof__label">
                {choice.label}
                {source ? (
                  <SourceChip
                    n={`p${i + 1}`}
                    title={source.source.title}
                    publisher={source.source.publisher}
                    date={source.source.date}
                    retrieved={source.source.retrieved}
                    url={source.source.url}
                  />
                ) : null}
              </span>
              <span class="proof__figure">
                {one.energyWh ? (
                  <Fragment>
                    {one.atLeast ? '≥ ' : ''}
                    {displayNumber(one.energyWh.central)}{' '}<small>Wh an exchange</small>
                  </Fragment>
                ) : (
                  'unknown'
                )}
              </span>
            </div>
            <RangeBar range={one.energyWh} ceiling={ceiling} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band">
    <div class="band__head">
      <Index n={5} of={sections} />
      <h2 class="band__title">Four ways in</h2>
    </div>

    <div class="buai-scroll-x">
      <table class="buai-table">
        <thead>
          <tr>
            <th scope="col">Where</th>
            <th scope="col">What it watches</th>
            <th scope="col">What it needs</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><a href="/install">Browser extension</a></td>
            <td>claude.ai, chatgpt.com, gemini.google.com, a local web interface</td>
            <td>Chrome or Firefox</td>
          </tr>
          <tr>
            <td><a href="/install#cli">Command line</a></td>
            <td>Claude Code and Codex CLI transcripts already on your disk</td>
            <td>Node or Python</td>
          </tr>
          <tr>
            <td><a href="/install#plugin">Claude Code plugin</a></td>
            <td>The session you are in, on the status line</td>
            <td>Claude Code</td>
          </tr>
          <tr>
            <td><a href="/calculator">This site</a></td>
            <td>Whatever you type into it</td>
            <td>A browser</td>
          </tr>
          <tr>
            <th scope="row">What any of them sends us</th>
            <td colspan="2">
              <Redacted>nothing at all</Redacted>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="note" style="margin-top: var(--space-4)">
      No account, no server, no analytics inside the tools. The <a href="/privacy">privacy page</a>{' '}
      names the one script this website loads and what it receives.
    </p>
  </section>

  <section class="band">
    <div class="band__head">
      <Index n={6} of={sections} />
      <h2 class="band__title">Running it yourself</h2>
    </div>

    <Hazard>
      <p style="margin-bottom: 0">
        Running a model on your own laptop is not automatically lighter. A data centre batches
        hundreds of requests onto one accelerator and runs it hard. Your machine runs one request
        and draws power for as long as it thinks. For a short answer from a small model your laptop
        usually wins. For a long answer from a large one it often does not, and the{' '}
        <a href="/calculator">calculator</a> will say which way it falls for the work you actually do.
      </p>
    </Hazard>
  </section>

  <section class="band">
    <div class="band__head">
      <Index n={7} of={sections} />
      <h2 class="band__title">Helping</h2>
    </div>

    <div class="prose">
      <p>
        The dataset is the part of this that matters, and it is only as good as its sources. The
        most useful thing anyone can send is a published measurement we have missed, with its
        boundary and its method written down. The second most useful is telling us a row is wrong,
        with a reason.
      </p>
      <p>
        The code, the data and every page here are in one{' '}
        <a href="https://github.com/betteruseofai/betteruseofai">public repository</a> under the MIT
        licence. <a href="https://github.com/betteruseofai/betteruseofai/blob/main/docs/dataset-contributing.md">What a row needs</a>{' '}
        before we take it is written down, and so is the one rule that trips people up: no model is
        ever named as an author here.
      </p>
    </div>
  </section>

  <section class="band">
    <Faq>
      <details>
        <summary>Is this a measurement?</summary>
        <p>
          No. Nothing here reads a power meter. It is arithmetic over published measurements of
          other people's hardware, applied to your token counts. The tape at the top of the page
          says so on every page for that reason.
        </p>
      </details>
      <details>
        <summary>Where do the numbers come from?</summary>
        <p>
          A dataset of published figures. Each one carries its source, the boundary it measured, a
          quality score and the date we last checked it. It
          ships with the tools and updates only when you update them. The{' '}
          <a href="/methodology">method page</a> walks through every step, and the whole dataset is
          downloadable as <a href="/methodology/data.json">one JSON file</a>.
        </p>
      </details>
      <details>
        <summary>Why does the water figure move so much?</summary>
        <p>
          Because "water" means three different things. Water evaporated in the cooling towers on
          site, water used at the power station that supplied the electricity, and water across the
          whole life of the hardware including the chips. We default to the first two and let you
          switch.
        </p>
      </details>
      <details>
        <summary>Does any of this leave my machine?</summary>
        <p>
          The extension and both command line tools make no network requests at all, and there is a
          test in the repository that reads the built files and fails if one appears. This website
          loads one analytics script from Cloudflare, which the privacy page names in full.
        </p>
      </details>
      <details>
        <summary>What does the picture behind the headline cost?</summary>
        <p>
          About six kilobytes of script, and one pass of a small shader on your graphics chip that
          plays once and then stops. The footer of every page prints what the page weighs. The Still
          button at the top switches the motion off and remembers that you asked.
        </p>
      </details>
    </Faq>
  </section>

  <script id="landing-table" type="application/json" is:inline set:html={JSON.stringify(table)} />
</Base>

<script>
  /**
   * The sentence at the top, wired up.
   *
   * The table was computed at build time by the same engine that runs in the
   * extension, so all this does is look up a cell and multiply by the number
   * in the box. It exists to avoid shipping the dataset to a landing page.
   */
  type Bounds = { low: number; central: number; high: number } | null;
  type Cell = { energyWh: Bounds; waterMl: Bounds; carbonG: Bounds; atLeast: boolean };

  const root = document.querySelector('[data-landing]');
  const payload = document.getElementById('landing-table');
  if (root && payload) {
    const table = JSON.parse(payload.textContent ?? '{}') as Record<string, Cell>;
    const dials = {
      prompts: root.querySelector<HTMLInputElement>('[data-dial="prompts"]'),
      model: root.querySelector<HTMLSelectElement>('[data-dial="model"]'),
      place: root.querySelector<HTMLSelectElement>('[data-dial="place"]'),
    };

    // Six significant digits, same rule as everywhere else. Kept here rather
    // than imported so the landing page pulls in no package at all.
    const show = (value: number): string => {
      if (!Number.isFinite(value)) return 'unknown';
      if (value === 0) return '0';
      const magnitude = Math.abs(value);
      if (magnitude >= 1e6 || magnitude < 1e-4) return value.toPrecision(3);
      const digits = Math.max(0, 3 - Math.floor(Math.log10(magnitude)) - 1);
      return value.toFixed(Math.min(digits, 4)).replace(/\.?0+$/, '');
    };

    const scaleUp = (bounds: Bounds, times: number): Bounds =>
      bounds ? { low: bounds.low * times, central: bounds.central * times, high: bounds.high * times } : null;

    const paintOne = (slot: string, bounds: Bounds, atLeast: boolean): void => {
      const box = root.querySelector(`[data-slot="${slot}"]`);
      if (!box) return;
      const figure = box.querySelector('.buai-readout__figure');
      const unit = figure?.querySelector('.buai-readout__unit')?.outerHTML ?? '';
      const boundsText = box.querySelector('.buai-readout__bounds');
      const readout = box.querySelector('.buai-readout');
      const bar = box.querySelector<HTMLElement>('.buai-rangebar');
      const scale = box.querySelectorAll('.buai-rangebar__scale span');

      if (!bounds) {
        readout?.classList.add('buai-readout--unknown');
        if (figure) figure.textContent = 'unknown';
        if (boundsText) boundsText.textContent = 'we have no figure for this combination';
        return;
      }

      readout?.classList.remove('buai-readout--unknown');
      if (figure) figure.innerHTML = `${atLeast ? '&ge; ' : ''}${show(bounds.central)}${unit}`;
      if (boundsText) boundsText.textContent = `[ ${show(bounds.low)} to ${show(bounds.high)} ]`;

      if (bar && bounds.high > 0) {
        const pc = (value: number): string => `${Math.min(100, (value / bounds.high) * 100).toFixed(1)}%`;
        bar.style.setProperty('--buai-low', pc(bounds.low));
        bar.style.setProperty('--buai-central', pc(bounds.central));
        bar.style.setProperty('--buai-high', '100%');
      }
      const texts = [bounds.low, bounds.central, bounds.high].map(show);
      scale.forEach((node, i) => {
        node.textContent = texts[i] ?? '';
      });
    };

    const paint = (): void => {
      const model = dials.model?.value ?? 'claude-opus-5';
      const place = dials.place?.value ?? 'WORLD';
      const raw = Number(dials.prompts?.value ?? 20);
      const times = Number.isFinite(raw) && raw > 0 ? Math.min(raw, 500) : 1;

      const cell = table[`${model}|${place}`];
      if (!cell) return;

      paintOne('energy', scaleUp(cell.energyWh, times), cell.atLeast);
      paintOne('water', scaleUp(cell.waterMl, times), cell.atLeast);
      paintOne('carbon', scaleUp(cell.carbonG, times), cell.atLeast);
    };

    for (const dial of Object.values(dials)) dial?.addEventListener('input', paint);
  }
</script>
