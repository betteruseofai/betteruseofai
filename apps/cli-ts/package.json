{
  "name": "betteruseofai",
  "version": "0.0.0",
  "description": "See the energy, water and carbon behind your own agent sessions. Everything is computed on your machine.",
  "license": "MIT",
  "homepage": "https://betteruseofai.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betteruseofai/betteruseofai.git",
    "directory": "apps/cli-ts"
  },
  "bugs": "https://github.com/betteruseofai/betteruseofai/issues",
  "type": "module",
  "bin": {
    "betteruseofai": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "llm",
    "energy",
    "water",
    "carbon",
    "claude-code",
    "codex"
  ],
  "scripts": {
    "build": "node scripts/embed-template.mjs && tsc -p tsconfig.build.json",
    "test": "node scripts/embed-template.mjs && vitest run",
    "typecheck": "node scripts/embed-template.mjs && tsc --noEmit",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@betteruseofai/core": "workspace:*",
    "@betteruseofai/dataset": "workspace:*",
    "@betteruseofai/readers": "workspace:*",
    "@betteruseofai/tokens": "workspace:*"
  }
}
