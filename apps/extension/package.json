{
  "name": "@betteruseofai/extension",
  "version": "0.0.0",
  "private": true,
  "description": "Browser extension: what your chat costs, counted on your own machine.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/copy-ranks.mjs && wxt build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:firefox": "node scripts/copy-ranks.mjs && wxt build -b firefox",
    "zip": "node scripts/copy-ranks.mjs && wxt zip",
    "dev": "wxt",
    "shoot": "node scripts/shoot-popup.mjs",
    "lint:firefox": "node scripts/copy-ranks.mjs && wxt build -b firefox && web-ext lint --source-dir .output/firefox-mv3 --no-config-discovery",
    "test:e2e": "node scripts/copy-ranks.mjs && wxt build && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@betteruseofai/core": "workspace:*",
    "@betteruseofai/dataset": "workspace:*",
    "@betteruseofai/tokenizers": "workspace:*",
    "@preact/signals": "^2.11.2",
    "idb": "^8.0.3",
    "preact": "^10.29.8",
    "zod": "^3.25.76",
    "@betteruseofai/tokens": "workspace:*",
    "@betteruseofai/ui-hint": "workspace:*"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "wxt": "^0.21.4"
  }
}
