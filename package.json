{
  "name": "betteruseofai-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck test",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-py-version.mjs",
    "postinstall": "simple-git-hooks",
    "parity": "node fixtures/run-parity.mjs",
    "copy": "vale docs README.md CONTRIBUTING.md PLAN.md apps packages",
    "copy:selftest": "node scripts/vale-selftest.mjs",
    "sync-dataset": "python apps/cli-py/scripts/sync-dataset.py",
    "check-chars": "node scripts/check-control-chars.mjs"
  },
  "simple-git-hooks": {
    "commit-msg": "node scripts/check-commit-msg.mjs $1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.1",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
